{
  "expo": {
    "name": "EVA",
    "slug": "eva",
    "scheme": "eva",
    "version": "1.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07080C",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "icon": "./assets/icon-ios.png",
      "bundleIdentifier": "cl.evaapp.eva",
      "appleTeamId": "5GKWMMZ46Q",
      "buildNumber": "3",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:eva-app.cl",
        "webcredentials:eva-app.cl",
        "applinks:www.eva-app.cl",
        "webcredentials:www.eva-app.cl"
      ],
      "entitlements": {
        "com.apple.security.application-groups": ["group.cl.evaapp.eva"]
      },
      "infoPlist": {
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": false,
        "NSCameraUsageDescription": "EVA usa la cámara para fotos de progreso y escanear códigos de barras de alimentos.",
        "NSPhotoLibraryUsageDescription": "Para seleccionar tu foto de perfil",
        "NSPhotoLibraryAddUsageDescription": "EVA guarda en tu galería la tarjeta de tu entrenamiento cuando eliges «Guardar». Solo escribe esa imagen; no lee tus fotos.",
        "NSMotionUsageDescription": "Para contar tus pasos durante el entrenamiento",
        "NSFaceIDUsageDescription": "Usá Face ID para entrar a EVA de forma segura.",
        "NSBluetoothAlwaysUsageDescription": "EVA usa Bluetooth para conectar tu sensor de frecuencia cardiaca (cinta o reloj) durante el cardio.",
        "NSHealthShareUsageDescription": "EVA lee tus pasos, sueño y entrenamientos (frecuencia cardiaca, distancia, calorías) desde Salud, solo con tu permiso.",
        "NSHealthUpdateUsageDescription": "EVA no escribe datos en Salud; solo los lee con tu permiso.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "cl.evaapp.eva",
      "versionCode": 1,
      "backgroundColor": "#07080C",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07080C"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eva-app.cl",
              "pathPattern": "/c/.*/login"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eva-app.cl",
              "path": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.eva-app.cl",
              "pathPattern": "/c/.*/login"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.eva-app.cl",
              "path": "/reset-password"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "eva-app.cl",
              "path": "/coach/subscription"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.eva-app.cl",
              "path": "/coach/subscription"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/eva-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#07080C",
          "dark": {
            "image": "./assets/eva-icon.png",
            "backgroundColor": "#07080C"
          }
        }
      ],
      "expo-router",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B0E13"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EVA usa la cámara para fotos de progreso y escanear códigos de barras de alimentos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EVA necesita acceso a tu galería para el check-in semanal."
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": []
        }
      ],
      [
        "react-native-share",
        {
          "ios": [
            "instagram",
            "instagram-stories",
            "facebook-stories",
            "whatsapp"
          ],
          "android": [
            "com.instagram.android",
            "com.facebook.katana",
            "com.whatsapp",
            "com.zhiliaoapp.musically"
          ]
        }
      ],
      "./plugins/with-android-cleartext",
      "./plugins/with-gradle-jvmargs",
      "./plugins/with-privacy-manifest",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "EVA usa Bluetooth para conectar tu sensor de frecuencia cardiaca (cinta o reloj) durante el cardio."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "EVA lee tus pasos, sueño y entrenamientos (frecuencia cardiaca, distancia, calorías) desde Salud, solo con tu permiso.",
          "NSHealthUpdateUsageDescription": "EVA no escribe datos en Salud; solo los lee con tu permiso."
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-connect",
      "react-native-notify-kit",
      "@bacons/apple-targets",
      "expo-secure-store",
      "./plugins/with-ios-modular-headers",
      [
        "@sentry/react-native/expo",
        {
          "organization": "eva-zs",
          "project": "eva-mobile"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/a5f4f7c0-861c-48b1-9ed6-fc46e7843844",
      "fallbackToCacheTimeout": 6000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "a5f4f7c0-861c-48b1-9ed6-fc46e7843844"
      },
      "facebookAppId": "28862306396704276"
    },
    "owner": "juandeveva"
  }
}
